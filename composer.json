{
    "name": "bleeding-deacons/freedom",
    "description": "Zero-configuration app settings for MAUI tablets: a Google-verified tablet, signed in through Fellowship, receives its application's key/value configuration, secrets sealed to the tablet's own key, and polls a per-key version manifest on every start.",
    "type": "wordpress-plugin",
    "license": "MIT (Modified)",
    "authors": [
        {
            "name": "The Bleeding Deacons"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/guardian"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/wp-mocks"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-zlib": "*"
    },
    "autoload": {
        "psr-4": {
            "Freedom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freedom\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:coverage": "pest --coverage-html ./tests/coverage",
        "build": "php build.php build:production",
        "build:production": "php build.php build:production",
        "build:dev": "php build.php build:dev",
        "build:clean": "php build.php clean",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcs:fix": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "require-dev": {
        "bleedingdeacons/guardian": "^1.0",
        "bleedingdeacons/wp-mocks": "^3.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "psr/container": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    }
}
